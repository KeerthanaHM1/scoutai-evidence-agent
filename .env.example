# GEMINI_API_KEY: Required for Gemini AI API calls (topic decomposition, synthesis, conflict analysis).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# WEB SEARCH PROVIDER KEYS (Configure at least one free search provider):
# 1. Tavily Search API (Recommended - 1,000 free searches/month, no credit card required)
#    Get free key at: https://tavily.com
TAVILY_API_KEY=""

# 2. Serper Google Search API (Alternative - 2,500 free searches, no credit card required)
#    Get free key at: https://serper.dev
SERPER_API_KEY=""

# 3. Brave Search API (Alternative - 2,000 free queries/month)
#    Get free key at: https://brave.com/search/api
BRAVE_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"
